{
  "name": "@fullstacksjs/toolbox",
  "version": "2.10.0",
  "license": "MIT",
  "author": "ASafaeirad <frontendmonster@gmail.com>",
  "description": "a zero-dependency collection of missing JavaScript utilities",
  "homepage": "https://toolbox.fullstacksjs.com",
  "repository": {
    "type": "git",
    "url": "git@github.com:fullstacksjs/toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/fullstacksjs/toolbox/issues"
  },
  "type": "module",
  "files": [
    "dist/",
    "src/",
    "mode.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "type-check": "tsc",
    "lint": "vp lint",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "prepublishOnly": "pkg-ok",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@fullstacksjs/oxlint-config": "0.6.1",
    "@semantic-release/github": "12.0.2",
    "@semantic-release/npm": "13.1.3",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "24.9.1",
    "@vitest/coverage-v8": "4.1.10",
    "cspell": "10.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "npm-run-all": "4.1.5",
    "oxlint": "1.76.0",
    "pkg-ok": "3.0.0",
    "semantic-release": "25.0.2",
    "typescript": "5.9.3",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  }
}
